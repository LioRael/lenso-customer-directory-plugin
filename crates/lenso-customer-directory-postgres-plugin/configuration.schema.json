{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostgreSQL Customer Directory Plugin configuration",
  "type": "object",
  "required": ["schema", "database_url_secret", "auth_issuer", "auth_assertion_public_key", "resolve_callers", "admin_callers", "export_callers", "retention_callers"],
  "properties": {
    "schema": { "type": "string" },
    "database_url_secret": { "type": "string" },
    "auth_issuer": { "type": "string" },
    "auth_assertion_public_key": { "type": "string" },
    "resolve_callers": { "type": "array", "items": { "type": "string" } },
    "admin_callers": { "type": "array", "items": { "type": "string" } },
    "export_callers": { "type": "array", "items": { "type": "string" } },
    "retention_callers": { "type": "array", "items": { "type": "string" } },
    "max_export_bytes": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
